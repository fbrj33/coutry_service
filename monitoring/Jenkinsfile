pipeline {
    agent any

    stages {
        stage('Checkout code') {
            steps {
                checkout scm
            }
        }

        stage('Check tools') {
            steps {
                sh '''
                    helm version --short
                    ansible --version | head -1
                    docker --version
                '''
            }
        }

        stage('Deploy kube-state-metrics') {
            steps {
                withCredentials([file(credentialsId: 'kubeconfig-file', variable: 'KUBECONFIG')]) {
                    sh '''
                        helm repo add prometheus-community https://prometheus-community.github.io/helm-charts --force-update
                        helm repo update
                        helm upgrade --install kube-state-metrics prometheus-community/kube-state-metrics \
                          -n monitoring --create-namespace --wait --timeout 5m
                    '''
                }
            }
        }

        stage('Deploy Prometheus') {
            steps {
                withCredentials([file(credentialsId: 'kubeconfig-file', variable: 'KUBECONFIG')]) {
                    sh '''
                        helm upgrade --install prometheus prometheus-community/prometheus \
                          -n monitoring -f monitoring/prom-values.yaml --wait --timeout 5m
                    '''
                }
            }
        }

        stage('Deploy Grafana') {
            steps {
                withCredentials([
                    file(credentialsId: 'kubeconfig-file', variable: 'KUBECONFIG'),
                    string(credentialsId: 'grafana-admin-password', variable: 'GRAFANA_PASS')
                ]) {
                    sh '''
                        set +x
                        helm repo add grafana https://grafana.github.io/helm-charts --force-update
                        helm repo update
                        helm upgrade --install grafana grafana/grafana \
                          -n monitoring -f monitoring/grafana-values.yaml \
                          --set-string adminPassword="$GRAFANA_PASS" --wait --timeout 5m
                    '''
                }
            }
        }

        stage('Verify') {
            steps {
                withCredentials([file(credentialsId: 'kubeconfig-file', variable: 'KUBECONFIG')]) {
                    sh 'helm list -n monitoring'
                }
            }
        }
    }

    post {
        success { echo 'Monitoring stack deployed.' }
        failure { echo 'Monitoring deployment failed. Check the stage logs.' }
    }
}
